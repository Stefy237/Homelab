[control_plane]
%{ for name, ip in control_planes ~}
${name} ansible_host=${ip}
%{ endfor ~}

[workers]
%{ for name, ip in workers ~}
${name} ansible_host=${ip}
%{ endfor ~}

[k8s_cluster:children]
control_plane
workers

[k8s_cluster:vars]
ansible_user=debian
ansible_ssh_private_key_file=~/.ssh/homelab